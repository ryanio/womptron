{
  "include": ["src/*.ts"],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "jest"],
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true
  }
}
